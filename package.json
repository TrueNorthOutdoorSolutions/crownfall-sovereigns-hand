{
  "name": "crownfall-sovereigns-hand",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && tsx scripts/print.ts && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run tests",
    "test:browser": "playwright test",
    "print:cards": "tsx scripts/print.ts",
    "simulate": "tsx scripts/simulate.ts",
    "sim:v02": "tsx scripts/v02-sim.ts 1000",
    "proto:validate": "tsx prototype-v0.2/tools/validate.mjs",
    "proto:print": "tsx prototype-v0.2/tools/build-print.mjs",
    "proto:snapshot": "tsx prototype-v0.2/tools/snapshot.mjs",
    "proto:masterlist": "tsx prototype-v0.2/tools/master-list.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
